{
  "name": "aero-sarathi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @aero/db prisma migrate dev",
    "db:reset": "pnpm --filter @aero/db prisma migrate reset --force",
    "db:seed": "pnpm --filter @aero/db seed",
    "db:generate": "pnpm --filter @aero/db prisma generate"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.10.1"
    }
  }
}
