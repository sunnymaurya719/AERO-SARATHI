NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://aero:aero@localhost:5432/aero
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017/aero_logs

# JWT
JWT_SECRET=dev-secret-change-me-min-32-characters-long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Google Maps (server key, never expose to browser)
GOOGLE_MAPS_API_KEY=
GOOGLE_DIRECTIONS_CACHE_TTL=3600

# MSG91
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=AEROSR
MSG91_BYPASS=true

# Quote / booking rules
MIN_LEAD_TIME_MIN=120
MAX_LEAD_TIME_DAYS=90
QUOTE_TTL_MIN=15

# Razorpay (server secret never exposed to browser)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_INTENT_TTL_MIN=15

# SendGrid transactional email
SENDGRID_API_KEY=
EMAIL_FROM="Aero Sarathi <bookings@aerosarathi.com>"

# MSG91 transactional template IDs (Phase 2)
MSG91_TEMPLATE_BOOKING_CONFIRMED=
MSG91_TEMPLATE_CANCELLATION=
MSG91_TEMPLATE_REFUND=
MSG91_TEMPLATE_PAYMENT_FAILED=

# Notifications: when true, SMS/email are logged instead of sent (dev only)
NOTIFY_BYPASS=true

# Public web URL used in SMS/email links
PUBLIC_WEB_URL=http://localhost:3000

# CORS
CORS_ORIGINS=http://localhost:3000,https://dev.aerosarathi.com

# ── Phase 3: Admin Panel ──
ADMIN_PANEL_ENABLED=true
ADMIN_SESSION_TTL_SEC=43200          # 12h absolute
ADMIN_SESSION_IDLE_SEC=1800          # 30 min idle
ADMIN_PASSWORD_PEPPER=               # 32 random bytes, base64 (openssl rand -base64 32)
ADMIN_TOTP_ISSUER=Aero Sarathi
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15
ADMIN_IP_ALLOWLIST=                  # CSV of CIDRs/IPs; empty disables allowlist
ADMIN_CORS_ORIGINS=http://localhost:3001,https://admin-dev.aerosarathi.com
ADMIN_INVITE_TTL_HOURS=48
ADMIN_PUBLIC_URL=http://localhost:3001
SENDGRID_TEMPLATE_ADMIN_INVITE=

# S3 / Hetzner Object Storage (driver documents). Local dev uses MinIO.
S3_ENDPOINT=http://localhost:9000
S3_REGION=fsn1
S3_BUCKET=aero-driver-docs-local
S3_KEY=aero
S3_SECRET=aero-secret-32-chars-min
S3_FORCE_PATH_STYLE=true
